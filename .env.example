# Telegram: токен от @BotFather
BOT_TOKEN=
# Ваш Telegram ID для уведомлений об оплатах (узнать у @userinfobot)
ADMIN_ID=

# GigaChat: ключ авторизации из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=
# Физлицо: GIGACHAT_API_PERS; ИП/юрлицо: GIGACHAT_API_B2B
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_CA_BUNDLE=/opt/mira/russian_trusted_root_ca.cer

# ЮKassa: shopId и секретный ключ (сначала тестовый магазин)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — только после одобрения автоплатежей в ЮKassa
YOOKASSA_AUTOPAY=0

PRICE_TRIAL=1
PRICE_MONTH=299
PRICE_SINGLE=149
TRIAL_DAYS=7
PRICE_DEEP=249
PRICE_FORECAST=199

# Реквизиты для оферты: ФИО самозанятого/ИП или название ООО, ИНН, почта для обращений
SELLER_NAME=
SELLER_INN=
SELLER_EMAIL=
